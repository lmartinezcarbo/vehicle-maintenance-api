# Copy to `.env` (gitignored) and fill in real values.
# The application reads these via pydantic-settings.

# --- Required ---------------------------------------------------------
# Signs access tokens and the refresh-token digests. Any long random
# string: `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
SECRET_KEY=change-me

# SQLAlchemy URL. Format: postgresql+psycopg://user:password@host:5432/dbname
# `docker compose up` provides a matching PostgreSQL on localhost:5432
# (POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB below).
DATABASE_URL=postgresql+psycopg://vehicle:vehicle@localhost:5432/vehicle_maintenance

# Test database (pytest drops and rebuilds its schema on every run).
TEST_DATABASE_URL=postgresql+psycopg://vehicle:vehicle@localhost:5432/vehicle_maintenance_test

# Transactional email (Brevo) and the verified sender address.
BREVO_API_KEY=
EMAIL_FROM=no-reply@example.com

# Stripe (test mode is fine) and the webhook signing secret.
STRIPE_SECRET_KEY=sk_test_
STRIPE_SUCCESS_URL=http://localhost:5173/app/payments/success
STRIPE_CANCEL_URL=http://localhost:5173/app/payments/cancel
STRIPE_WEBHOOK_SECRET=whsec_

# --- Optional (have defaults, but the deploy sets them) ---------------
# Cloudinary vehicle photos; uploads fail loudly until these are set.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Comma-separated allowed browser origins. Default: http://localhost:3000
CORS_ORIGINS=http://localhost:5173

# Public portfolio demo. Leave it unset (off) for a real deployment: when
# true, the three seeded accounts can sign in without the emailed 2FA code.
# DEMO_MODE=true

# --- docker-compose only (credentials of the local database) ----------
POSTGRES_USER=vehicle_user
POSTGRES_PASSWORD=vehicle_password
POSTGRES_DB=vehicle_maintenance